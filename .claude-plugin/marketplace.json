{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "mfd-marketplace",
  "version": "0.1.0",
  "description": "MFD — Model-First Development plugin marketplace",
  "owner": {
    "name": "MFD Project",
    "email": "mfd@example.com"
  },
  "plugins": [
    {
      "name": "mfd",
      "description": "Model-First Development — parser, validator, diagrams, contracts, visual dashboard, and LSP for .mfd files",
      "version": "0.1.0",
      "author": {
        "name": "MFD Project"
      },
      "source": "./mfd",
      "category": "development",
      "lspServers": {
        "mfd-lsp": {
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/dist/lsp/server.js", "--stdio"],
          "extensionToLanguage": {
            ".mfd": "mfd"
          }
        }
      }
    }
  ]
}
