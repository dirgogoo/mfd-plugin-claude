#!/usr/bin/env bash
# MFD MCP server wrapper — installs deps before starting server
# This ensures the MCP server works on first launch (before SessionStart hook)
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

SDK_SERVER_JS="$PLUGIN_DIR/node_modules/@modelcontextprotocol/sdk/dist/esm/server/index.js"
if [ ! -d "$PLUGIN_DIR/node_modules" ] || [ ! -f "$SDK_SERVER_JS" ]; then
  rm -rf "$PLUGIN_DIR/node_modules" "$PLUGIN_DIR/package-lock.json"
  npm cache clean --force --silent 2>/dev/null
  (cd "$PLUGIN_DIR" && npm install --omit=dev --silent 2>/dev/null)
fi

exec node "$PLUGIN_DIR/dist/mcp/server.js" "$@"
