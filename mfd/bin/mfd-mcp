#!/usr/bin/env bash
# MFD MCP server wrapper — installs deps before starting server
# This ensures the MCP server works on first launch (before SessionStart hook)
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
PLUGIN_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ ! -d "$PLUGIN_DIR/node_modules" ]; then
  npm install --production --prefix "$PLUGIN_DIR" --silent 2>/dev/null
fi

exec node "$PLUGIN_DIR/dist/mcp/server.js" "$@"
