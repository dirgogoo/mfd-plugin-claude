{
  "name": "mfd",
  "version": "0.1.0",
  "description": "Model-First Development — parser, validator, diagram renderer, implementation contracts, visual dashboard, and LSP for .mfd files",
  "author": {
    "name": "MFD Project",
    "email": "mfd@example.com"
  },
  "repository": "https://github.com/dirgogoo/mfd-plugin-claude",
  "license": "MIT",
  "keywords": ["mfd", "model-first", "dsl", "parser", "validator", "diagrams"],
  "mcpServers": {
    "mfd-tools": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/mcp/server.js"]
    }
  },
  "lspServers": {
    "mfd": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/dist/lsp/server.js", "--stdio"],
      "extensionToLanguage": {
        ".mfd": "mfd"
      }
    }
  }
}
